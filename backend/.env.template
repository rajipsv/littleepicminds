# Copy to backend/.env for local npm scripts (never commit .env). Vercel: set the same keys in Project Settings.
DATABASE_URL=your_neon_postgres_connection_string_here
JWT_SECRET=generate_a_long_random_string_here
# Optional: token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# One-time admin bootstrap (npm run db:seed-admin) — do not commit real values
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ChangeMeNow1

# Password reset emails (Resend — https://resend.com)
# APP_BASE_URL=https://littleepicminds.vercel.app
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=littleEpicMinds <noreply@yourdomain.com>
# Local dev without email: PASSWORD_RESET_DEV_EXPOSE=true shows reset link in API response

# TTS chain: hybrid = Sarvam → Google → browser (client) when both APIs fail
# browser = server never calls Sarvam/Google; app uses device voice immediately
# Modes: hybrid | auto | sarvam-only | google | browser
TTS_PROVIDER=hybrid
# Frontend: skip server TTS entirely (device voice only for meanings/lines)
# VITE_TTS_BROWSER_ONLY=true
#
# Sarvam (primary) — dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
#
# Google Cloud TTS (fallback) — recommended when Sarvam credits run out
# 1. GCP project → enable "Cloud Text-to-Speech API"
# 2. Billing enabled (free tier still needs a billing account)
# 3. APIs & Services → Credentials → Create API key → restrict to Text-to-Speech API
# GOOGLE_TTS_API_KEY=your_google_cloud_api_key_here
# Or service account JSON path:
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# TTS file cache — same text+lang never calls Sarvam/Google twice (canonical key)
# Default: lib/data/audio_cache (bundled on Vercel via vercel.json includeFiles)
# TTS_CACHE_DIR=lib/data/audio_cache

# Dhruv chant audio — REQUIRED for production (R2 only; no HF playback fallback)
# Upload: npm run gita:upload-r2 (after gita:sync-hf-audio)
GITA_AUDIO_BASE_URL=https://pub-xxxxx.r2.dev
VITE_GITA_AUDIO_BASE_URL=https://pub-xxxxx.r2.dev
# R2 upload credentials (local script only — do not commit .env):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# Apply CORS on bucket: scripts/r2-cors-gita-audio.json (Vercel origin only; GET/HEAD + Range for line seek)

# Line meanings: batch translate offline (no live API spend in production)
# npm run gita:translate-lines
TRANSLATE_LIVE=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
