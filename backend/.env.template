PORT=5000
DATABASE_URL=your_neon_postgres_connection_string_here
JWT_SECRET=littleEpicMinds_secret_2026

# TTS: auto (default, no Google unless key set) | sarvam | hybrid | google | browser
# browser = server skips APIs; app uses free built-in browser voice only
TTS_PROVIDER=auto
# Google: requires billing account on GCP even for free tier — skip if you have no card
# GOOGLE_TTS_API_KEY=your_google_cloud_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Sarvam: signup at dashboard.sarvam.ai (may include trial credits; no card for signup)
SARVAM_API_KEY=your_sarvam_api_key_here
# TTS file cache — same text+lang never calls Sarvam/Google twice (canonical key)
# Default write: backend/data/audio_cache. Also reads lib/data/audio_cache if present (Vercel bundle).
# TTS_CACHE_DIR=backend/data/audio_cache
# TTS_CACHE_EXTRA_DIRS=lib/data/audio_cache
# After npm run gita:prewarm-tts, copy/sync to lib/data/audio_cache for deploy (optional)

# Line meanings: batch translate offline (no live API spend in production)
# npm run gita:translate-lines
TRANSLATE_LIVE=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
